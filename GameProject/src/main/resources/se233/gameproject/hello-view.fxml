<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="se233.gameproject.controller.GameController"
            prefWidth="800"
            prefHeight="640"
            style="-fx-background-color: #101626;">

    <top>
        <HBox alignment="CENTER" spacing="12" prefHeight="76"
              style="-fx-background-color: #fffaf6; -fx-border-color: transparent transparent #d8cde1 transparent; -fx-border-width: 0 0 2 0; -fx-padding: 8 28 8 28;">
            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label text="SCORE"
                       style="-fx-text-fill: #9a8aac; -fx-font-size: 10px; -fx-font-weight: bold; -fx-letter-spacing: 2px;"/>
                <Label fx:id="scoreLabel" text="000000"
                       style="-fx-text-fill: #594b7d; -fx-font-size: 25px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="levelLabel" text="LEVEL 01"
                   style="-fx-background-color: #f0e8f3; -fx-background-radius: 22px; -fx-padding: 10 22 10 22; -fx-text-fill: #665681; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 2px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label text="LIVES"
                       style="-fx-text-fill: #9a8aac; -fx-font-size: 10px; -fx-font-weight: bold; -fx-letter-spacing: 2px;"/>
                <HBox fx:id="heartsBox" alignment="CENTER_RIGHT" spacing="2"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <StackPane>
            <Canvas fx:id="gameCanvas"
                    width="800"
                    height="600"
                    focusTraversable="true"/>

            <VBox fx:id="upgradeMenu" alignment="CENTER" spacing="20" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.7);">
                <Label text="STAGE CLEAR! CHOOSE AN UPGRADE"
                       style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>

                <!-- ปุ่มตัวเลือกอัปเกรด -->
                <Button fx:id="upgradeBtn1" onAction="#selectUpgrade1"
                        prefWidth="300" prefHeight="50" style="-fx-font-size: 16px;"/>
                <Button fx:id="upgradeBtn2" onAction="#selectUpgrade2"
                        prefWidth="300" prefHeight="50" style="-fx-font-size: 16px;"/>
                <Button fx:id="upgradeBtn3" onAction="#selectUpgrade3"
                        prefWidth="300" prefHeight="50" style="-fx-font-size: 16px;"/>
            </VBox>
        </StackPane>

    </center>

</BorderPane>
