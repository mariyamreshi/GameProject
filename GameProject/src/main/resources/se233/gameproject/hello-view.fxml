<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="se233.gameproject.controller.GameController"
            prefWidth="800"
            prefHeight="640"
            style="-fx-background-color: #101626;">

    <top>
        <HBox alignment="CENTER" spacing="40"
              prefHeight="40"
              style="-fx-background-color: #202b42;">
            <Label fx:id="scoreLabel"
                   text="Score: 0"
                   style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Label fx:id="livesLabel"
                   text="Lives: 3"
                   style="-fx-text-fill: white; -fx-font-size: 16px;"/>
        </HBox>
    </top>

    <center>
        <Canvas fx:id="gameCanvas"
                width="800"
                height="600"
                focusTraversable="true"/>
    </center>

</BorderPane>